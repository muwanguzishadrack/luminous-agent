APP_NAME="Luminous Commerce"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Phase 0: Herd host. Phase 1 (webhooks): switch to https://platform.luminouscrm.com (docs/03 §3)
APP_URL=https://luminous-agent.test
APP_LOCAL_URL=https://luminous-agent.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=luminous
DB_USERNAME=luminous_app
DB_PASSWORD=secret
DB_MIGRATOR_USERNAME=luminous_migrator
DB_MIGRATOR_PASSWORD=secret

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=56379

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=luminous
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=58085
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:57700
MEILISEARCH_KEY=masterKeyChangeMe

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=luminous
AWS_SECRET_ACCESS_KEY=secretsecret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=luminous-media
AWS_ENDPOINT=http://127.0.0.1:59000
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=51025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@luminouscrm.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Meta (fill from your password manager — never paste in chat) ----
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_ES_CONFIG_ID=
META_SOLUTION_ID=
META_SYSTEM_TOKEN=

# ---- Meta Business Agent ----
# Prefix only; per-tenant connector URL is ${MBA_CONNECTOR_BASE_URL}/{tenant}
MBA_CONNECTOR_BASE_URL="${APP_URL}/connectors/v1"

# ---- ioTec Pay (Phase 3) ----
IOTEC_TOKEN_URL=https://id.iotec.io/connect/token
IOTEC_BASE_URL=https://pay.iotec.io
IOTEC_CLIENT_ID=
IOTEC_CLIENT_SECRET=
IOTEC_WALLET_ID_UGX=
IOTEC_WALLET_ID_ITX=
IOTEC_CALLBACK_HEADER_NAME=X-Iotec-Signature
IOTEC_CALLBACK_HEADER_VALUE=
IOTEC_DEFAULT_CURRENCY=UGX

VITE_APP_NAME="${APP_NAME}"
